[gd_resource type="Resource" script_class="NetworkEvent" format=3]

[ext_resource type="Script" path="res://resources/network_event.gd" id="1"]

[resource]
script = ExtResource("1")
event_name = "Syndication Backlash"
description = "Loyal listeners are grumbling that this Show feels like reheated leftovers from another station."
